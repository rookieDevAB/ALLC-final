generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  REVIEWER
}

enum WaitlistStatus {
  NEW
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  PENDING
  REFUNDED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(ADMIN)
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  auditEvents   AuditEvent[]   @relation("ActorAuditEvents")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WaitlistApplication {
  id            String         @id @default(cuid())
  fullName      String
  email         String
  healthVector  String?
  rationale     String
  status        WaitlistStatus @default(NEW)
  priorityScore Int            @default(0)
  adminNotes    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([email])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("ActorAuditEvents", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType, entityId])
}

model BlogPost {
  id               String   @id @default(cuid())
  title            String
  shortDescription String
  content          String
  category         String
  author           String   @default("Dr. Divya Gautam")
  coverImage       String?
  tags             Json     @default("[]")
  published        Boolean  @default(false)
  date             DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published, createdAt])
  @@index([category])
}

// ─── Customer (patient-facing accounts) ─────────────────────────────────────

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders ServiceOrder[]

  refreshTokens CustomerRefreshToken[]

  @@index([email])
}

model CustomerRefreshToken {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─── Services ────────────────────────────────────────────────────────────────

model Service {
  id            String           @id              // "00", "01" … "08"
  programNumber String                            // "CONSULTATION", "PROGRAM 01"
  title         String
  subtitle      String?
  category      String
  description   String           @db.Text
  outcomes      Json             @default("[]")   // string[]
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)

  pathways      ServicePathway[]
  orderItems    OrderItem[]

  @@index([isActive])
}

model ServicePathway {
  id          String   @id                        // "ind", "couple", "ind-ess" …
  serviceId   String
  name        String
  duration    String
  description String   @db.Text
  priceRs     Int                                 // 0 = no price → redirect to contact
  isActive    Boolean  @default(true)

  service    Service      @relation(fields: [serviceId], references: [id])
  orderItems OrderItem[]

  @@index([serviceId])
}

model ServiceOrder {
  id                String      @id @default(cuid())
  txnid             String      @unique            // "ALLC-<timestamp>-<random>"
  payuMihpayid      String?                        // PayU's mihpayid after payment
  payuHash          String?                        // response hash for verification

  patientName       String
  patientEmail      String
  patientPhone      String

  totalAmountRs     Int
  status            OrderStatus @default(CREATED)
  payuStatus        String?                        // "success" / "failure" / "pending"
  payuResponse      Json?                          // full raw PayU response

  customerId        String?                        // linked after customer registers
  customer          Customer?   @relation(fields: [customerId], references: [id])

  items             OrderItem[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([patientEmail])
  @@index([txnid])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  serviceId   String
  pathwayId   String
  priceRs     Int                                  // snapshot price at purchase time

  order   ServiceOrder   @relation(fields: [orderId], references: [id])
  service Service        @relation(fields: [serviceId], references: [id])
  pathway ServicePathway @relation(fields: [pathwayId], references: [id])

  @@index([orderId])
}
